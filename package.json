{
  "name": "quickjs-emscripten-cli",
  "version": "0.1.2",
  "description": "quickjs-emscripten-cli",
  "main": "dist/index.js",
  "bin": "./bin/cli.js",
  "types": "./dist/index.d.ts",
  "author": "ahaoboy",
  "license": "MIT",
  "homepage": "https://github.com/ahaoboy/quickjs-emscripten-cli",
  "files": [
    "cjs",
    "esm"
  ],
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js",
      "default": "./cjs/index.js"
    },
    "./tool": {
      "types": "./esm/tool.d.ts",
      "import": "./esm/tool.js",
      "require": "./cjs/tool.js",
      "default": "./cjs/tool.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahaoboy/quickjs-emscripten-cli.git"
  },
  "scripts": {
    "build:cjs": "tsc --outDir cjs --declaration false --module commonjs",
    "build:esm": "tsc --outDir esm --module esnext",
    "build": "npm run build:cjs && npm run build:esm"
  },
  "keywords": [
    "quickjs-emscripten"
  ],
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "quickjs-emscripten": "^0.31.0"
  }
}